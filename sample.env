# Bear & Berry operator app
# Copy this file to .env.local (dev), .env.staging, or .env.production

# development | staging | production
# Local development and staging share one Mongo database for now.
# Database name is derived from APP_ENV unless MONGODB_DB_NAME is set:
#   development -> bear_and_berry_staging
#   staging     -> bear_and_berry_staging
#   production  -> bear_and_berry_prod
APP_ENV=development

# Public origin of this app (used for auth cookies / redirects)
AUTH_URL=http://localhost:3000

# 32+ character secret used to sign session JWTs
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Session lifetime in days
SESSION_TTL_DAYS=7

# MongoDB
# Local and staging use the same URI / database for now.
# Production should use a dedicated cluster or database user.
MONGODB_URI=mongodb://127.0.0.1:27017
# Optional override. Leave blank to use the APP_ENV-derived name.
MONGODB_DB_NAME=

# Lead ingest (public POST /apis/leads)
# Required in staging and production. Landing page should send:
#   x-api-key: <LEADS_INGEST_API_KEY>
# Optional in development (ingest is open if unset).
LEADS_INGEST_API_KEY=

# Comma-separated origins allowed to call public APIs (CORS)
# Example: https://bearandberry.in,https://staging.bearandberry.in
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# First-admin bootstrap only. Not a login API secret.
# Used once to create the first super_admin when the users collection is empty.
# MongoDB stores a bcrypt hash of this password, never the plaintext.
# After that first user exists, these values are unused and can be deleted.
SEED_ADMIN_NAME=Bear & Berry Admin
SEED_ADMIN_EMAIL=admin@bearandberry.in
SEED_ADMIN_PASSWORD=change-me-now-please
# true | false -- seed a small demo fleet when the database is empty
SEED_DEMO_DATA=true

# Optional SMTP (lead notifications; persistence still succeeds if unset)
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_TEAM_RECIPIENTS=yuganksingh05@gmail.com,badbudarsingh@gmail.com

# Git branches: main (local), staging, prod
#
# Staging:
#   APP_ENV=staging
#   AUTH_URL=https://app-staging.bearandberry.in
#   MONGODB_URI=<same cluster/db as local for now>
#
# Production:
#   APP_ENV=production
#   AUTH_URL=https://app.bearandberry.in
#   MONGODB_URI=<production cluster>
#   AUTH_SECRET=<unique, never reused from staging>
#   LEADS_INGEST_API_KEY=<unique>
#   SEED_DEMO_DATA=false
