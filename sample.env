# Copy this file to .env.local for local development.
# Staging and production values are set on the host.
# `next build` fails if required variables are missing.

# Config

# development | staging | production
# Local and staging share one Mongo database for now.
# Database name is derived from APP_ENV:
#   development -> bear_and_berry_staging
#   staging     -> bear_and_berry_staging
#   production  -> bear_and_berry_prod
APP_ENV=development

# Public origin of this app (invite links, cookies, CORS)
SELF_URL=http://localhost:3001

# Public origin of the landing page (revalidate + CORS)
LANDING_URL=http://localhost:3000

SESSION_TTL_DAYS=7
INVITE_TTL_DAYS=7

# First-admin bootstrap only. Used once when the users collection is empty.
# That person chooses their own name and password on first sign-in.
SEED_ADMIN_EMAIL=yugank@bearandberry.in

# SMTP is used for lead notifications, signup OTPs, and team invitations.
# Lead notification recipients live in the database (Leads → notification emails).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_EMAIL=

# Secrets

# Shared landing key: lead ingest and blog revalidation
# Must match LANDING_KEY on the landing-page project
# Generate with: openssl rand -base64 32
LANDING_KEY=replace-with-a-long-random-secret

# 32+ character secret used to sign session JWTs
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

MONGODB_URI=mongodb://127.0.0.1:27017
SMTP_PASSWORD=

# Staging host:
#   APP_ENV=staging
#   SELF_URL=https://dev.app.bearandberry.in
#   LANDING_URL=https://dev.bearandberry.in
#   LANDING_KEY=<same as the staging landing page>
#   AUTH_SECRET=<staging jwt secret>
#   MONGODB_URI=<same cluster/db as local for now>
#
# Production host:
#   APP_ENV=production
#   SELF_URL=https://app.bearandberry.in
#   LANDING_URL=https://bearandberry.in
#   LANDING_KEY=<unique>
#   AUTH_SECRET=<unique, never reused from staging>
#   MONGODB_URI=<production cluster>
